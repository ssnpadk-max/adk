        if inputCode == "" then
            notify("تنبيه ⚠️", "يرجى كتابة الكود أولاً!", 3)
            return
        end

        if not validCodes[inputCode] then
            notify("خطأ ❌", "الكود غير صحيح أو غير موجود!", 3)
            return
        end

        if codeData.usedCodes[inputCode] then
            notify("خطأ ❌", "هذا الكود تم استخدامه وحرقه مسبقاً!", 3)
            return
        end

        codeData.usedCodes[inputCode] = true
        validCodes[inputCode] = nil
        
        local currentTime = os.time()
        local currentExpiry = (codeData.premiumUntil and codeData.premiumUntil > currentTime) and codeData.premiumUntil or currentTime
        codeData.premiumUntil = currentExpiry + (7 * 24 * 60 * 60)
        saveCodeData()

        isPremiumUser = true
        notify("مبروك! 🌟", "🎉 تم تفعيل الكود بنجاح وحرقه! حصلت على 7 أيام VIP.", 5)
    end
