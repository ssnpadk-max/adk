-- دوال المساعدة للتحكم والحركة
local function CleanHazards()
    pcall(function()
        for _, name in ipairs({"Lava_Stage3", "NPC_Zone5", "MovingWalls"}) do
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Model") and v.Name == name then
                    v:Destroy()
                elseif v:IsA("BasePart") then
                    local nm = v.Name:lower()
                    if nm:find("kill") or nm:find("lava") or nm:find("acid") or nm:find("death") or nm:find("hazard") then
                        v.CanTouch = false
                    end
                end
            end
        end
    end)
end

local function SetHoverVelocity(active)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if active then
        if root and (not HoverBV or not HoverBV.Parent) then
            HoverBV = Instance.new("BodyVelocity")
            HoverBV.Velocity = Vector3.new(0, 0, 0)
            HoverBV.MaxForce = Vector3.new(0, math.huge, 0)
            HoverBV.Parent = root
        end
    else
        if HoverBV then
            HoverBV:Destroy()
            HoverBV = nil
        end
    end
end

local function CancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
end

local function BuildFarmPath()
    local path = {}
    if Cfg.SelectedWorld == "World 3" then
        if Cfg.SelectedTarget == "فارم 5.5b كأس" then
            for _, v in ipairs(WaypointsData.W3_Part1) do table.insert(path, v) end
            for i, v in ipairs(WaypointsData.W3_Part2) do if i ~= 3 then table.insert(path, v) end end
            for _, v in ipairs(WaypointsData.W3_Part3) do table.insert(path, v) end
            for _, v in ipairs(WaypointsData.W3_Part4) do table.insert(path, v) end
        elseif Cfg.SelectedTarget == "فارم 3.5b كأس" then
            for _, v in ipairs(WaypointsData.W3_Part1) do table.insert(path, v) end
            for i, v in ipairs(WaypointsData.W3_Part2) do if i ~= 3 then table.insert(path, v) end end
            for _, v in ipairs(WaypointsData.W3_Part3) do table.insert(path, v) end
        elseif Cfg.SelectedTarget == "فارم 2b كأس" then
            for _, v in ipairs(WaypointsData.W3_Part1) do table.insert(path, v) end
            for _, v in ipairs(WaypointsData.W3_Part2) do table.insert(path, v) end
        else
            for _, v in ipairs(WaypointsData.W3_Part1) do table.insert(path, v) end
        end
    elseif Cfg.SelectedWorld == "World 2" then
        if Cfg.SelectedTarget == "فارم 600k كأس" then
            path = WaypointsData.W2_600k
        elseif Cfg.SelectedTarget == "فارم 400k كأس" then
            path = WaypointsData.W2_400k
        else
            path = WaypointsData.W2_250k
        end
    end
    return path
end

local function TweenToPosition(targetPos)
    if IsRespawning then return false end
    
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then
        IsRespawning = true
        return false
    end
    
    local dist = (targetPos - root.Position).Magnitude
    local timeToTravel = dist / Cfg.GlideSpeed
    
    hum:ChangeState(Enum.HumanoidStateType.Running)
    SetHoverVelocity(true)
    root.Anchored = false
    
    if timeToTravel < 0.05 then
        root.CFrame = CFrame.new(targetPos)
        return true
    end
    
    local twInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    CurrentTween = TweenService:Create(root, twInfo, {CFrame = CFrame.new(targetPos)})
    CurrentTween:Play()
    CurrentTween.Completed:Wait()
    
    return true
end

local function TweenToWinBlock(blockName, fallbackPos)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local targetPos = fallbackPos
    local foundPart = workspace:FindFirstChild(blockName, true)
    if foundPart then
        targetPos = foundPart:IsA("BasePart") and foundPart.Position or foundPart:GetPivot().Position
    end
    
    local dist = (targetPos - root.Position).Magnitude
    local twInfo = TweenInfo.new(dist / Cfg.GlideSpeed, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    CurrentTween = TweenService:Create(root, twInfo, {CFrame = CFrame.new(targetPos)})
    CurrentTween:Play()
    CurrentTween.Completed:Wait()
end

local function StartStateKeeper()
    if HeartbeatConn then HeartbeatConn:Disconnect() end
    HeartbeatConn = RunService.Heartbeat:Connect(function()
        if not Cfg.AutoFarmActive then return end
        local char = player.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local st = hum:GetState()
            if st ~= Enum.HumanoidStateType.Running and st ~= Enum.HumanoidStateType.Jumping then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
    end)
end

-- تشغيل الأوتو فارم
local function StartWaypointAutoFarm()
    if Cfg.AutoFarmActive then return end
    Cfg.AutoFarmActive = true
    IsRespawning = false
    
    CleanHazards()
    StartStateKeeper()
    
    if CharAddedConn then CharAddedConn:Disconnect() end
    CharAddedConn = player.CharacterAdded:Connect(function()
        if Cfg.AutoFarmActive then
            IsRespawning = true
            CancelTween()
            SetHoverVelocity(false)
            task.wait(0.4)
            IsRespawning = false
            StartStateKeeper()
        end
    end)
    
    task.spawn(function()
        while Cfg.AutoFarmActive do
            if IsRespawning then task.wait(0.1) end
            
            local currentPath = BuildFarmPath()
            
            for i = 1, #currentPath do
                if not Cfg.AutoFarmActive or IsRespawning then break end
                local success = TweenToPosition(currentPath[i])
                if not success then
                    task.wait(0.1)
                end
            end
            
            if Cfg.AutoFarmActive and not IsRespawning then
                if Cfg.SelectedWorld == "World 2" then
                    if Cfg.SelectedTarget == "فارم 600k كأس" then
                        TweenToWinBlock("WinBlock18", Vector3.new(-397.63, 607.67, 615))
                    elseif Cfg.SelectedTarget == "فارم 400k كأس" then
                        TweenToWinBlock("WinBlock17", Vector3.new(-413.77, 511.58, 440))
                    elseif Cfg.SelectedTarget == "فارم 250k كأس" then
                        TweenToWinBlock("WinBlock16", Vector3.new(-414.67, 508.91, 195))
                    end
                elseif Cfg.SelectedWorld == "World 3" then
                    if Cfg.SelectedTarget == "فارم 5.5b كأس" then
                        TweenToWinBlock("WinBlock38", Vector3.new(-3215.93, 682.43, 1461.07))
                    elseif Cfg.SelectedTarget == "فارم 3.5b كأس" then
                        TweenToWinBlock("WinBlock37", Vector3.new(-2062.84, 505.46, 1458.08))
                    elseif Cfg.SelectedTarget == "فارم 2b كأس" then
                        TweenToWinBlock("WinBlock36", Vector3.new(-1430.49, 542.94, 1329.7))
                    elseif Cfg.SelectedTarget == "فارم 1.2b كأس" then
                        TweenToWinBlock("WinBlock35", Vector3.new(-1432.49, 544.95, 758.3))
                    end
                end
            end
            
            SetHoverVelocity(false)
            task.wait(0.5)
        end
    end)
end

-- إيقاف الأوتو فارم
local function StopWaypointAutoFarm()
    Cfg.AutoFarmActive = false
    IsRespawning = false
    CancelTween()
    SetHoverVelocity(false)
    if CharAddedConn then CharAddedConn:Disconnect() end
    if HeartbeatConn then HeartbeatConn:Disconnect() end
end
