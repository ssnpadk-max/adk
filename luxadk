local function DeleteAllHazards()
    local deletedCount = 0
    pcall(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                local nm = v.Name:lower()
                if nm:find("kill") or nm:find("lava") or nm:find("acid") or nm:find("death") or nm:find("hazard") or nm:find("spike") or nm:find("tsunami") or nm:find("wave") then
                    v:Destroy()
                    deletedCount = deletedCount + 1
                end
            elseif v:IsA("Model") then
                local nm = v.Name:lower()
                if nm:find("lava") or nm:find("hazard") or nm:find("movingwalls") or nm:find("tsunami") or nm:find("wave") then
                    v:Destroy()
                    deletedCount = deletedCount + 1
                end
            end
        end
    end)
    return deletedCount
end

