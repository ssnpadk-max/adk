local function GetServerActiveCount()
    local count = 0
    local currentTime = os.time()
    for playerName, lastPing in pairs(ActiveScriptUsers) do
        if Players:FindFirstChild(playerName) then
            if currentTime - lastPing <= 8 then count = count + 1 end
        else
            ActiveScriptUsers[playerName] = nil
        end
    end
    return math.max(count, 1)
end

local function GetOtherServersCount()
    local baseOtherServers = math.floor((os.time() % 120) * 1.8) + 145
    return baseOtherServers
end

