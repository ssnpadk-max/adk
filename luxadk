local TargetUsername = "ldl_160100"
local followCacheFile = "lux_follow_cache_v2.json"

local function CheckFollowStatus()
    if isOwner then return true end
    local myUserIdStr = tostring(player.UserId)

    if readfile and isfile and isfile(followCacheFile) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(followCacheFile)) end)
        if success and type(data) == "table" and data[myUserIdStr] == true then
            return true
        end
    end

    local isFollowing = false
    pcall(function()
        local targetId = Players:GetUserIdFromNameAsync(TargetUsername)
        local myId = player.UserId
        local cursor = ""
        
        for page = 1, 10 do
            local url = "https://friends.roblox.com/v1/users/" .. myId .. "/followings?limit=100" .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
            local rawResponse = game:HttpGet(url)
            local response = HttpService:JSONDecode(rawResponse)
            
            if response and response.data then
                for _, user in ipairs(response.data) do
                    if user.id == targetId or (user.username and user.username:lower() == TargetUsername:lower()) then
                        isFollowing = true
                        break
                    end
                end
            end
            
            if isFollowing or not response or not response.nextPageCursor or response.nextPageCursor == "" then
                break
            end
            cursor = response.nextPageCursor
        end
    end)

    if isFollowing and writefile then
        pcall(function()
            local cacheData = {}
            if isfile(followCacheFile) then
                pcall(function() cacheData = HttpService:JSONDecode(readfile(followCacheFile)) or {} end)
            end
            cacheData[myUserIdStr] = true
            writefile(followCacheFile, HttpService:JSONEncode(cacheData))
        end)
    end

    return isFollowing
end

